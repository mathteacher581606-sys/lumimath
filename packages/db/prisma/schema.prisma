generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// NGƯỜI DÙNG
// =========================================================

// Mã OTP xác thực email (đăng ký học sinh)
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String   @default("REGISTER")
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([email, purpose])
}

// Ngân hàng nhận xét dùng lại của giáo viên (gợi ý khi chấm bài)
model CommentTemplate {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  category  String?
  createdAt DateTime @default(now())

  @@index([teacherId])
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role
  fullName      String
  avatarUrl     String?
  school        String?
  className     String?
  grade         Int?
  workplace     String?
  birthDate     DateTime?
  phone         String?
  parentPhone   String?
  theme         String?   // bảng màu chọn trong Cài đặt (paper|chalk|garden|blueprint|notebook)
  teacherCode   String?  @unique
  studentCode   String?  @unique
  xp            Int      @default(0)
  level         Int      @default(1)
  streakDays    Int      @default(0)
  lastActiveAt  DateTime @default(now())
  isActive      Boolean  @default(true)
  emailNotify   Boolean  @default(true)
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  taughtCourses   Course[]        @relation("TeacherCourses")
  assistedCourses CourseAssistant[]
  enrollments     Enrollment[]
  assignmentSubmissions AssignmentSubmission[]
  questionBank    QuestionBank?
  exams           Exam[]
  examFolders     ExamFolder[]
  matrices        ExamMatrix[]
  attempts        ExamAttempt[]
  achievements    Achievement[]
  notifications   Notification[]
  comments        LessonComment[]
  reviews         CourseReview[]
  reminders       DeadlineReminder[]
  dailyQuests     DailyQuest[]
  commentTemplates CommentTemplate[]

  @@index([role])
  @@index([studentCode])
  @@index([teacherCode])
}

// =========================================================
// KHÓA HỌC & BÀI GIẢNG
// =========================================================

model Course {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  coverUrl    String?  // Ảnh đại diện (hiện trên thẻ khóa học bên ngoài)
  bannerUrl   String?  // Banner khóa học (hiện bên trong trang khóa học)
  grade       Int?
  subject     String   @default("Toán")
  isPublished Boolean  @default(false)
  sequential  Boolean  @default(false)
  password    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  reviews     CourseReview[]
  announcements Announcement[]
  assignments Assignment[]
  assistants  CourseAssistant[]

  @@index([teacherId])
}

// Trợ giảng: 1 tài khoản giáo viên được cấp quyền quản lý 1 khóa học (không phải chủ)
model CourseAssistant {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  chapter     String?
  order       Int      @default(0)
  youtubeUrl  String?
  pdfLinks    String[] @default([])
  videos      Json?    @default("[]") // [{title, url}] — nhiều video có tiêu đề
  materials   Json?    @default("[]") // [{title, url}] — tài liệu đặt tên riêng
  content     String?  @db.Text
  duration    Int?
  examId      String?
  exam        Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progresses  LessonProgress[]
  comments    LessonComment[]
  reminders   DeadlineReminder[]
  quiz        LessonQuiz?
  blocks      Json?
  notes       LessonNote[]
  isPreviewFree Boolean @default(false)
  hidden      Boolean  @default(false) // bài nháp: học sinh không thấy
  publishAt   DateTime? // hẹn giờ mở bài; trước thời điểm này học sinh chỉ thấy tên bài
  assignments Assignment[]

  @@index([courseId])
}
model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  completed   Boolean  @default(false)
  watchedSec  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([lessonId, studentId])
}

// =========================================================
// QUIZ CỦNG CỐ TRONG BÀI GIẢNG
// =========================================================

model LessonQuiz {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  examId          String
  questionCount   Int      @default(5)
  passingPercent  Float    @default(50)
  negativeMarking Boolean  @default(false)
  negativeWeight  Float    @default(0)
  maxAttempts     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts LessonQuizAttempt[]

  @@unique([lessonId])
  @@index([examId])
}

model LessonQuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      LessonQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  score     Float
  passed    Boolean
  answers   Json?
  createdAt DateTime @default(now())

  @@index([quizId, studentId])
}

// Ghi chú cá nhân của học sinh trong từng bài giảng
model LessonNote {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
}

model Enrollment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress   Float    @default(0)
  enrolledAt DateTime @default(now())

  @@unique([courseId, studentId])
}

// =========================================================
// THẢO LUẬN BÀI GIẢNG + ĐÁNH GIÁ KHÓA HỌC
// =========================================================

model LessonComment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([lessonId])
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([courseId])
}

// =========================================================
// BẢNG TIN KHÓA HỌC
// =========================================================

model Announcement {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId  String
  content    String   @db.Text
  images     String[] @default([])
  pinned     Boolean  @default(false)
  allowVote  Boolean  @default(false)
  voteOptions String[] @default([])
  voteDeadline DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments   AnnouncementComment[]
  reactions  AnnouncementReaction[]
  votes      AnnouncementVote[]

  @@index([courseId])
}

model AnnouncementComment {
  id             String   @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  @@index([announcementId])
}

model AnnouncementReaction {
  id             String   @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  @@unique([announcementId, userId])
}

model AnnouncementVote {
  id             String   @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  optionIndex    Int
  createdAt      DateTime @default(now())

  @@unique([announcementId, userId])
}

// =========================================================
// GIAO BÀI TẬP TRONG KHÓA HỌC
// =========================================================

model Assignment {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId     String
  title         String
  description   String?  @db.Text
  kind          String   @default("CUSTOM") // EXAM | TULUAN | CUSTOM
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  lessonId      String?  // bài tập giao ngay trong một bài giảng
  lesson        Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questionIds   String[] @default([]) // tự luận lấy từ ngân hàng
  customContent String?  @db.Text // tự gõ đề
  customQuestions String[] @default([]) // tự gõ NHIỀU câu tự luận
  pdfUrl        String?  // đính kèm PDF đề (tùy chọn)
  assignDate    DateTime?
  dueDate       DateTime?
  classDeadlines Json? // [{className, dueDate}] — hạn nộp riêng theo lớp (ưu tiên hơn dueDate)
  minScoreForAnswers Float? // điểm tối thiểu đạt để xem đáp án
  hideAnswers   Boolean  @default(false)
  revealAnswersAt DateTime? // ẩn đáp án đến thời điểm này
  showLeaderboard Boolean @default(false)
  allowResubmit Boolean  @default(false)
  maxResubmit   Int?     // số lần SỬA tối đa sau lần nộp đầu (null = không giới hạn, 0 = không được sửa)
  lockAfterGraded Boolean @default(true) // khoá sửa khi giáo viên đã chấm
  maxAttempts Int        @default(0) // số lần nộp tối đa (0 = không giới hạn theo bài giao)
  // ===== Chính sách nộp muộn (Canvas late_policy) =====
  lateDeductionPercent Float? // trừ % điểm mỗi khoảng thời gian trễ
  lateIntervalHours    Int    @default(24) // khoảng trễ tính phạt (giờ)
  lateMinPercent       Float?  // sàn tối thiểu % điểm còn lại sau phạt
  missingDeductionPercent Float? // trừ % khi quá hạn mà không nộp
  // ===== Post Policy (công bố điểm đồng loạt — Canvas) =====
  postManually Boolean   @default(false) // chấm ẩn điểm: HS chỉ thấy khi GV bấm "Công bố"
  gradesPosted Boolean   @default(false) // đã công bố điểm chưa
  postAt       DateTime? // hẹn giờ tự công bố
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions AssignmentSubmission[]
  submissionHistory AssignmentSubmissionHistory[]

  @@index([courseId])
  @@index([examId])
  @@index([lessonId])
}

model AssignmentSubmission {
  id             String   @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content        String?  @db.Text
  imageUrls      String[] @default([])
  pdfUrl         String?
  answers        Json?    // đáp án trắc nghiệm khi bài giao là đề thi
  score          Float?
  assessment     String? // Đ | CĐ | HT | CHT | HTT
  teacherComment String?  @db.Text
  aiComment      String?  @db.Text // nhận xét tự động (dùng khi GV chưa nhận xét)
  essayScores    Json?    // điểm thủ công từng phần tự luận: {questionId: [diemY a, diemY b, ...]}
  penaltyPoints  Float    @default(0) // điểm phạt nộp muộn
  aiScore        Float?
  aiFeedback     String?  @db.Text
  annotations    Json?
  status         String   @default("SUBMITTED") // SUBMITTED | GRADED | RETURNED
  published      Boolean  @default(false) // GV chốt mới công bố cho HS
  submittedAt    DateTime @default(now())
  gradedAt       DateTime?

  history        AssignmentSubmissionHistory[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

// Lịch sử từng lần nộp/sửa bài (để giáo viên đối chiếu)
model AssignmentSubmissionHistory {
  id           String   @id @default(cuid())
  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  version      Int
  content      String?  @db.Text
  imageUrls    String[] @default([])
  pdfUrl       String?
  answers      Json?
  submittedAt  DateTime @default(now())

  @@unique([submissionId, version])
  @@index([submissionId])
  @@index([assignmentId])
}

// =========================================================
// NGÂN HÀNG ĐỀ
// =========================================================

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  MULTI_ANSWER
}

enum Difficulty {
  NHAN_BIET
  THONG_HIEU
  VAN_DUNG
  VAN_DUNG_CAO
}

model QuestionBank {
  id         String   @id @default(cuid())
  teacherId  String   @unique
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name       String   @default("Ngân hàng mặc định")
  createdAt  DateTime @default(now())

  questions  Question[]
  topics     Topic[]
  forms      BankForm[]
  sources    BankSource[]
}

model BankForm {
  id        String       @id @default(cuid())
  bankId    String
  bank      QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())

  @@unique([bankId, name])
}

// Nguồn đề (Trường / Sở / Đề HKI / Đề HSG...)
model BankSource {
  id        String       @id @default(cuid())
  bankId    String
  bank      QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())

  @@unique([bankId, name])
}

model Topic {
  id        String   @id @default(cuid())
  bankId    String
  bank      QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name      String
  grade     Int?
  parentId  String?
  parent    Topic?   @relation("TopicTree", fields: [parentId], references: [id])
  children  Topic[]  @relation("TopicTree")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  questions Question[]
  exams     Exam[]

  @@index([bankId, parentId])
}

model Question {
  id            String       @id @default(cuid())
  code          String       @unique
  bankId        String
  bank          QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type          QuestionType
  content       String       @db.Text
  options       Json?
  answer        Json
  solution      String?      @db.Text
  grade         Int?
  topicId       String?
  topic         Topic?       @relation(fields: [topicId], references: [id])
  form          String?
  source        String?
  difficulty    Difficulty?
  aiClassified  Boolean      @default(false)
  aiMetadata    Json?
  texSource     String?      @db.Text
  usageCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  examItems     ExamItem[]

  @@index([bankId])
  @@index([type])
  @@index([difficulty])
  @@index([grade])
  @@index([form])
  @@index([source])
}

// =========================================================
// ĐỀ THI
// =========================================================

model Exam {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  grade       Int?
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  folderId    String?
  folder      ExamFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  difficulty  String?
  duration    Int      @default(45)
  totalScore  Float    @default(10)
  matrix      Json?
  source      String?
  texSource   String?  @db.Text
  pdfUrl      String?
  status      String   @default("DRAFT")
  isTemplate  Boolean  @default(false)
  maxAttempts Int      @default(3)
  published   Boolean  @default(false)
  // ===== Thiết lập thi (Canvas-style) =====
  passMark       Float?   // điểm chuẩn đậu (0-10); null = không xét đậu
  practiceMode   Boolean  @default(false) // chế độ luyện tập: hiện đáp án từng câu ngay
  answersAtEnd   Boolean  @default(true)  // ẩn đáp án đến hết bài (false = xem ngay từng câu)
  oneTimeResults Boolean  @default(false) // kết quả/đáp án chỉ xem đúng 1 lần
  hideAnswersAt  DateTime? // khóa đáp án sau mốc giờ này
  extraTime      Int      @default(0)     // cộng thêm phút (HS cần hỗ trợ)
  // ===== Phòng luyện đề (TSA/HSA) =====
  examKind    String  @default("STANDARD") // STANDARD | PRACTICE_TSA | PRACTICE_HSA
  sections    Json?   // [{title, duration, count}] — thời gian từng phần của đề luyện
  archivedAt  DateTime? // đã LƯU TRỮ (ẩn khỏi kho + học sinh, giữ nguyên bài làm); null = đang dùng
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ExamItem[]
  attempts    ExamAttempt[]
  lessons     Lesson[]
  assignments Assignment[]

  @@index([teacherId])
  @@index([folderId])
}

// Thư mục đề thi (cây mục lục Kho đề thi)
model ExamFolder {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    ExamFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ExamFolder[] @relation("FolderTree")
  exams     Exam[]
  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([parentId])
}

model ExamItem {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  part       Int
  order      Int
  score      Float

  @@unique([examId, order])
}

// Ma trận đề lưu trong kho (Trang "Quản lý ma trận đề")
model ExamMatrix {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  // Cấu trúc: { parts: [{ type, count }], slots: [{ part, type, form, difficulty, questionId }] }
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

model ExamAttempt {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      Json
  score        Float?
  rawScore     Float?   // điểm gốc (chấm tự động) trước fudge/phạt
  fudgePoints  Float    @default(0) // điểm nới tay của GV
  penaltyPoints Float   @default(0) // điểm phạt nộp muộn
  perPart      Json?
  antiCheat    Json?
  late         Boolean  @default(false)
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  timeSpent    Int?
  resultsViewedAt DateTime? // lần cuối HS xem kết quả (cho one_time_results)
  regradedAt   DateTime? // lần chấm lại gần nhất

  @@index([studentId])
  @@index([examId])
}

// =========================================================
// GAMIFICATION
// =========================================================

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  name      String
  icon      String?
  earnedAt  DateTime @default(now())

  @@unique([userId, code])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?  @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// =========================================================
// NHẮC NỘP BÀI + NHIỆM VỤ HẰNG NGÀY
// =========================================================

model DeadlineReminder {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([lessonId, studentId])
  @@index([lessonId])
}

model DailyQuest {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questKey  String
  date      String
  createdAt DateTime @default(now())

  @@unique([studentId, questKey, date])
}